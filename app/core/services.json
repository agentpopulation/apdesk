{
 "note": "Dedicated services that are not chat models: web search, page reading and voice or audio. Several labelled keys each, typed in by the owner (Models, or Settings > Keys and logins); the next key is used when one is refused or out of allowance. Modules read a key with ctx.serviceKey(id); the value never leaves the server. Each test is one small real call of that service: for search, one query with one result; for voice and audio, a read of the account or voice list, which spends nothing. Free allowances are as the providers stated them in November 2026 and may change.",
 "services": {
  "serper":     { "kind": "search", "name": "Serper (Google results)", "env": "SERPER_API_KEY",     "signup": "https://serper.dev",                      "header": "X-API-KEY",      "free": "2,500 free searches on sign-up",
                  "test": { "method": "POST", "url": "https://google.serper.dev/search", "body": { "q": "weather", "num": 1 }, "spends": "A test uses one search." } },
  "tavily":     { "kind": "search", "name": "Tavily",                  "env": "TAVILY_API_KEY",     "signup": "https://app.tavily.com",                  "header": "Authorization",  "prefix": "Bearer ", "free": "1,000 free searches a month",
                  "test": { "method": "POST", "url": "https://api.tavily.com/search", "body": { "query": "weather", "max_results": 1, "search_depth": "basic" }, "spends": "A test uses one basic search." } },
  "brave":      { "kind": "search", "name": "Brave Search",            "env": "BRAVE_API_KEY",      "signup": "https://brave.com/search/api/",           "header": "X-Subscription-Token", "free": "Free plan with a monthly allowance",
                  "test": { "method": "GET", "url": "https://api.search.brave.com/res/v1/web/search?q=weather&count=1", "spends": "A test uses one search." } },
  "exa":        { "kind": "search", "name": "Exa",                     "env": "EXA_API_KEY",        "signup": "https://dashboard.exa.ai/api-keys",       "header": "x-api-key",      "free": "Free credits on sign-up",
                  "test": { "method": "POST", "url": "https://api.exa.ai/search", "body": { "query": "weather", "numResults": 1 }, "spends": "A test uses one search." } },
  "jina":       { "kind": "search", "name": "Jina Reader and Search",  "env": "JINA_API_KEY",       "signup": "https://jina.ai/api-dashboard",           "header": "Authorization",  "prefix": "Bearer ", "free": "Free tokens on sign-up",
                  "test": { "method": "GET", "url": "https://r.jina.ai/https://example.com", "headers": { "Accept": "text/plain" }, "spends": "A test reads one tiny page, a few hundred tokens." } },
  "elevenlabs": { "kind": "audio",  "name": "ElevenLabs (voices, speech to text)", "env": "ELEVENLABS_API_KEY", "signup": "https://elevenlabs.io/app/settings/api-keys", "header": "xi-api-key", "free": "Free plan: about 10 minutes of speech a month",
                  "test": { "method": "GET", "url": "https://api.elevenlabs.io/v2/voices?page_size=1", "spends": "A test reads the voice list and spends nothing." } },
  "deepgram":   { "kind": "audio",  "name": "Deepgram (speech to text, voices)",   "env": "DEEPGRAM_API_KEY",   "signup": "https://console.deepgram.com",                "header": "Authorization", "prefix": "Token ", "free": "Free credit on sign-up",
                  "test": { "method": "GET", "url": "https://api.deepgram.com/v1/projects", "spends": "A test reads your projects and spends nothing." } },
  "cartesia":   { "kind": "audio",  "name": "Cartesia (voices)",                   "env": "CARTESIA_API_KEY",   "signup": "https://play.cartesia.ai/keys",               "header": "X-API-Key",    "free": "Free plan with monthly credits",
                  "test": { "method": "GET", "url": "https://api.cartesia.ai/voices", "headers": { "Cartesia-Version": "2024-06-10" }, "spends": "A test reads the voice list and spends nothing." } },
  "assemblyai": { "kind": "audio",  "name": "AssemblyAI (speech to text)",         "env": "ASSEMBLYAI_API_KEY", "signup": "https://www.assemblyai.com/dashboard",        "header": "Authorization", "free": "Free credit on sign-up",
                  "test": { "method": "GET", "url": "https://api.assemblyai.com/v2/transcript?limit=1", "spends": "A test reads your last transcript list and spends nothing." } }
 },
 "alsoAudio": "OpenAI and Groq keys (under model providers) also do speech: OpenAI text to speech and Whisper, Groq Whisper. Local and free: whisper.cpp and Piper through the Voice module, and the browser's own dictation and read-aloud."
}
